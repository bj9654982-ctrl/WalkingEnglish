/* 全局样式 - 光遇风暖金暗夜基调 */
page {
  --gold: #f5c97b;
  --gold-light: #ffe9c2;
  --ink: #1f2a44;
  --ink-deep: #131b30;
  --mist: #8fa3c8;
  --grass: #7fae7a;
  background: #0e1424;
  color: #f3eddf;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.btn-primary {
  background: linear-gradient(135deg, #f7d392, #e8a75c);
  color: #4a3418;
  border-radius: 999rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(232, 167, 92, 0.35);
}
.btn-primary::after { border: none; }

.btn-ghost {
  background: rgba(255, 255, 255, 0.08);
  color: #e8e2d2;
  border: 1rpx solid rgba(245, 201, 123, 0.4);
  border-radius: 999rpx;
}
.btn-ghost::after { border: none; }

.glass-card {
  background: rgba(31, 42, 68, 0.72);
  border: 1rpx solid rgba(245, 201, 123, 0.22);
  border-radius: 28rpx;
  backdrop-filter: blur(8rpx);
}

/* 通用返回按钮：各页面左上角常驻，深色底 + 暖金描边 */
.page-back {
  position: fixed;
  top: 20rpx;
  left: 24rpx;
  z-index: 90;
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 28rpx 0 20rpx;
  border-radius: 999rpx;
  background: rgba(18, 26, 44, 0.66);
  border: 1rpx solid rgba(245, 201, 123, 0.34);
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.28);
  color: #f6ead2;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}
.page-back-hover { background: rgba(245, 201, 123, 0.24); }
.page-back-icon {
  font-size: 38rpx;
  line-height: 1;
  margin: -4rpx 8rpx 0 0;
}
/* 放进自定义导航栏时跟随排版，不再悬浮 */
.page-back-inline {
  position: static;
  flex-shrink: 0;
}
