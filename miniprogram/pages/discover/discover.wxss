@import '../../styles/hub.wxss';
.city-cover { position:relative; overflow:hidden; border-radius:25rpx; min-height:310rpx; color:#fff9e9; }
.city-cover image,.city-overlay { position:absolute; width:100%; height:100%; }
.city-overlay { background:linear-gradient(0deg,rgba(34,63,47,.85),rgba(34,63,47,.1)); }
.city-copy { position:relative; padding:35rpx; padding-top:65rpx; }
.city-copy .subtitle,.city-copy .eyebrow { color:#e5e9d6; }.city-copy .hero-title { font-size:35rpx; }
.mountain-number { font-size:37rpx; font-style:italic; color:#a0ab8a; width:64rpx; }.mountain-hover { background:#eeefdf; }
