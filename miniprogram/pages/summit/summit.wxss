/* pages/summit/summit.wxss */
.summit-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #2a2a52 0%, #6a4a68 35%, #d88a5c 70%, #f0b878 100%);
  padding: 48rpx 40rpx 60rpx;
  box-sizing: border-box;
  position: relative;
}

/* Sky scenery */
.sky {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 70vh;
  overflow: hidden;
  pointer-events: none;
}
.sun-disc {
  position: absolute;
  top: 200rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #fff3d8, #ffd98f);
  box-shadow: 0 0 120rpx 40rpx rgba(255, 220, 150, 0.6);
}
.cloud-sea {
  position: absolute;
  bottom: 120rpx;
  left: -10%;
  width: 120%;
  height: 180rpx;
  background:
    radial-gradient(ellipse 200rpx 70rpx at 15% 100%, rgba(255,255,255,0.55), transparent),
    radial-gradient(ellipse 260rpx 90rpx at 50% 100%, rgba(255,255,255,0.5), transparent),
    radial-gradient(ellipse 220rpx 80rpx at 85% 100%, rgba(255,255,255,0.55), transparent);
}
.far-hills {
  position: absolute;
  bottom: 90rpx;
  left: 0;
  width: 100%;
  height: 160rpx;
  background:
    linear-gradient(135deg, transparent 49%, rgba(70,60,90,0.55) 50%) 0 0 / 300rpx 160rpx repeat-x,
    linear-gradient(45deg, transparent 49%, rgba(60,50,80,0.5) 50%) 100rpx 0 / 360rpx 160rpx repeat-x;
}
.lake-view {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 120rpx;
  background: linear-gradient(180deg, rgba(120, 150, 190, 0.5), rgba(90, 120, 170, 0.7));
}

/* Certificate */
.cert {
  position: relative;
  margin-top: 420rpx;
  background: linear-gradient(165deg, rgba(253, 246, 232, 0.96), rgba(244, 230, 205, 0.96));
  border-radius: 32rpx;
  padding: 44rpx 44rpx 36rpx;
  color: #4a3a24;
  box-shadow: 0 20rpx 60rpx rgba(60, 30, 10, 0.3);
}
.cert-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cert-brand { font-size: 24rpx; color: #a07a48; letter-spacing: 3rpx; }
.cert-no { font-size: 22rpx; color: #b09060; }
.cert-name {
  font-size: 72rpx;
  font-weight: 700;
  text-align: center;
  margin-top: 28rpx;
  letter-spacing: 6rpx;
  color: #3a2a14;
}
.cert-alias {
  text-align: center;
  font-size: 24rpx;
  color: #8a6a40;
  margin-top: 10rpx;
}
.cert-line {
  width: 100rpx;
  height: 3rpx;
  background: #c8a668;
  margin: 36rpx auto;
}
.cert-stats { display: flex; }
.cs-item { flex: 1; text-align: center; }
.cs-num { font-size: 40rpx; font-weight: 700; color: #b07838; }
.cs-label { font-size: 22rpx; color: #8a7050; margin-top: 8rpx; }
.cert-foot {
  text-align: center;
  font-size: 20rpx;
  color: #a08860;
  margin-top: 36rpx;
}

/* Grand slam */
.grand-slam {
  position: relative;
  text-align: center;
  margin-top: 36rpx;
  color: #fff6e0;
}
.gs-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 12rpx rgba(120, 60, 20, 0.5);
}
.gs-sub { font-size: 24rpx; margin-top: 12rpx; opacity: 0.9; }

/* Actions */
.actions { position: relative; margin-top: 40rpx; }
.act-share {
  background: linear-gradient(135deg, #f7d392, #e8a75c);
  color: #4a3418;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 20rpx 0;
  box-shadow: 0 10rpx 28rpx rgba(80, 40, 10, 0.3);
}
.act-share::after { border: none; }
.act-row {
  display: flex;
  justify-content: center;
  margin-top: 28rpx;
}
.act-next {
  font-size: 26rpx;
  color: #fff3d8;
  padding: 14rpx 36rpx;
  border: 1rpx solid rgba(255, 240, 210, 0.6);
  border-radius: 999rpx;
  margin-right: 20rpx;
}
.act-home {
  font-size: 26rpx;
  color: rgba(255, 243, 220, 0.85);
  padding: 14rpx 36rpx;
}
