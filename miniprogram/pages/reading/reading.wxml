<view class="hub">
<block wx:if="{{!article}}"><view class="english-heading"><text class="eyebrow">STORIES ALONG THE WAY</text><speech-button text="STORIES ALONG THE WAY" compact="{{true}}" label="听读"/></view><view class="title">读一页，走远一点。</view><view class="subtitle">山间小故事，也是一场轻轻的英语练习。</view>
<view class="reading-banner">山风翻开书页<text>TAKE YOUR TIME</text><speech-button text="Take your time" compact="{{true}}"/></view>
<view wx:for="{{articles}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openArticle"><view class="row"><text class="tag">{{item.level}} · {{item.minutes}} 分钟</text><text class="link">{{item.done?'已读 ✓':'开始阅读 ↗'}}</text></view><view class="english-title">{{item.title}}</view><speech-button text="{{item.title}}" label="听标题" /><view class="name">{{item.name}}</view><view class="muted spaced">{{item.intro}}</view></view></block>
<block wx:else><view class="row"><text class="link" bindtap="closeArticle">‹ 返回书页</text><button class="small-btn" bindtap="toggleTranslation">{{showTranslation?'收起译文':'显示译文'}}</button></view><view class="english-title">{{article.title}}</view><view class="listening-tools"><speech-button text="{{article.title}}" label="听标题" /><speech-button segments="{{articleAudio}}" label="整篇朗读"/></view><view class="subtitle">{{article.name}} · {{article.level}}</view>
<view class="paragraph" wx:for="{{article.paragraphs}}" wx:key="en"><view class="english">{{item.en}}</view><speech-button text="{{item.en}}" label="朗读本段" /><view wx:if="{{showTranslation}}" class="translation">{{item.zh}}</view></view>
<view class="card"><view class="section-title">随手记下的词</view><view class="vocab row" wx:for="{{article.words}}" wx:key="w"><text>{{item.w}} <text class="muted">{{item.mean}}</text></text><speech-button text="{{item.w}}" label="发音" /></view></view>
<view class="card"><view class="name">{{article.question}}</view><speech-button text="{{article.question}}" label="朗读问题" /><view wx:for="{{article.choices}}" wx:key="*this" class="audio-answer"><button data-index="{{index}}" bindtap="choose" class="answer {{answer===index?'selected':''}}" disabled="{{finished}}">{{item}}</button><speech-button text="{{item}}" label="听选项" compact="{{true}}"/></view><view wx:if="{{feedback}}" class="muted spaced">{{feedback}}<speech-button text="{{feedback}}" label="听英文" compact="{{true}}"/></view><view wx:if="{{finished}}" class="tag spaced">已完成阅读 ✓</view></view></block>
</view>
