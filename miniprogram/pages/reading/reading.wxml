<view class="hub paper-shelf">
  <view class="english-heading"><view class="eyebrow"><lookup-text text="IMAGE QUALITY PAPERS" source="页面寄语"/></view><speech-button text="Image Quality Papers" compact="{{true}}"/></view>
  <view class="title">把论文，读进日常。</view><view class="subtitle">你的图像质量评价资料库 · {{total}} 篇本地论文</view>
  <view class="shelf-summary"><view><text class="summary-number">{{stats.completed}}</text><text class="muted">篇已读</text></view><view><text class="summary-number">{{stats.started}}</text><text class="muted">篇在读</text></view><view><text class="summary-number">{{stats.bookmarked}}</text><text class="muted">篇收藏</text></view></view>
  <input class="field search-field" value="{{query}}" bindinput="search" placeholder="搜索 SSIM、TOPIQ、论文标题或年份" confirm-type="search"/>
  <view class="chips paper-categories"><button wx:for="{{categories}}" wx:key="id" class="chip {{category===item.id?'active':''}}" data-id="{{item.id}}" bindtap="selectCategory">{{item.name}}</button></view>
  <view class="row shelf-tools"><text class="muted">{{papers.length}} 篇资料</text><view class="tool-actions"><button class="filter-button {{onlyBookmarks?'chosen':''}}" bindtap="toggleBookmarks">{{onlyBookmarks?'★ 只看收藏':'☆ 收藏'}}</button><button class="filter-button" bindtap="changeSort">{{sort==='newest'?'年份 ↓':sort==='oldest'?'年份 ↑':'最近阅读'}}</button></view></view>
  <view wx:for="{{papers}}" wx:key="id" class="card paper-card" data-id="{{item.id}}" bindtap="openPaper" hover-class="paper-pressed" aria-role="button" aria-label="{{'阅读'+item.method}}">
    <view class="row"><text class="method-tag">{{item.method}}</text><text class="muted">{{item.year}} · {{item.pageCount}} 页 <text wx:if="{{item.bookmarked}}">★</text></text></view>
    <view class="paper-title-row"><view class="paper-title"><lookup-text text="{{item.title}}" source="{{item.method+' · 标题'}}"/></view><speech-button text="{{item.title}}" label="听标题" compact="{{true}}" icon-only="{{true}}"/></view><view class="paper-name">{{item.name}}</view><view class="paper-meta"><text class="tag">{{item.categoryName}}</text><text wx:if="{{item.versionNote}}" class="version-tag">版本说明</text><text class="muted">{{item.language}}</text></view>
    <view wx:if="{{item.visited}}" class="bar"><view class="fill" style="width:{{item.percent}}%"/></view>
    <view class="row paper-tail"><text class="muted">{{item.done?'已读 ✓':item.visited?'上次读到第 '+item.lastPage+' 页':'阅读全文 · 保存阅读位置'}}</text><text class="link">{{item.visited?'继续阅读':'打开论文'}} ↗</text></view>
  </view>
  <view wx:if="{{!papers.length}}" class="empty">没有找到匹配的论文。<button class="secondary spaced" bindtap="clearSearch">清除筛选</button></view>
  <view class="muted footer-note">来自你提供的 PDF，按内容核对并去重。包含期刊论文、会议论文及本地稿件；文字版保留原文件页码。</view>
</view>
