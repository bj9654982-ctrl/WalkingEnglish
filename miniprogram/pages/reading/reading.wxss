@import '../../styles/hub.wxss';
.shelf-summary { display:flex; gap:48rpx; margin:28rpx 0; padding:24rpx 0; border-top:1rpx solid #dfdfcf; border-bottom:1rpx solid #dfdfcf; }
.shelf-summary>view { display:flex; align-items:baseline; gap:9rpx; }
.summary-number { font-size:39rpx; font-weight:650; }
.search-field { margin:24rpx 0 12rpx; border:1rpx solid #d7ddcd; }
.paper-categories { gap:10rpx; margin:18rpx 0; }
.paper-categories .chip { width:auto; font-size:21rpx; padding:12rpx 17rpx; }
.shelf-tools { margin:24rpx 0 18rpx; }
.tool-actions { display:flex; gap:14rpx; }
.filter-button { width:auto; background:transparent; color:#7d8773; font-size:23rpx; padding:8rpx; margin:0; line-height:1.5; }
.filter-button.chosen { color:#365b48; }
.paper-card { padding:26rpx; }
.method-tag { color:#365b48; font-size:27rpx; font-weight:700; letter-spacing:1rpx; }
.paper-title { font-family:Georgia,serif; font-size:31rpx; line-height:1.5; margin:18rpx 0 10rpx; overflow-wrap:break-word; }
.paper-title-row { display:flex; align-items:center; gap:14rpx; }
.paper-title-row .paper-title { flex:1; min-width:0; }
.paper-name { font-size:25rpx; color:#7b836f; line-height:1.6; }
.paper-meta { display:flex; align-items:center; flex-wrap:wrap; gap:14rpx; margin-top:18rpx; }
.version-tag { font-size:20rpx; color:#94764b; }
.paper-tail { margin-top:22rpx; }
.paper-pressed { opacity:.8; }
.footer-note { margin:36rpx 0 0; }
