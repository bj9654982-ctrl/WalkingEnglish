@import '../../styles/hub.wxss';
.reading-banner{padding:65rpx 28rpx;margin:30rpx 0;border-radius:24rpx;background:linear-gradient(110deg,#dce4cf,#ece7c9);text-align:center;font-size:36rpx;letter-spacing:7rpx}.reading-banner text{display:block;font-size:18rpx;margin-top:18rpx}
.english-title{font-family:Georgia,serif;font-size:40rpx;line-height:1.35;margin:25rpx 0 12rpx}.paragraph{margin:34rpx 0}.english{font-family:Georgia,serif;font-size:33rpx;line-height:1.9;color:#374e41}.translation{margin-top:18rpx;line-height:1.9;font-size:26rpx;color:#82907b}.vocab{padding:16rpx 0;font-size:28rpx}.answer{text-align:left;padding:22rpx;margin:18rpx 0 0;font-size:27rpx;line-height:1.6;border-radius:14rpx;color:#415641;background:#eeeee1}.answer.selected{background:#dce6d1}.answer[disabled]{color:#536747}
