<view class="chat-page"><view class="chat-header row"><view class="avatar">{{profile.avatar||'🌿'}}</view><view class="grow"><view class="name">{{profile.nickname||'营地私信'}}</view><speech-button text="{{profile.nickname}}" label="听英文" compact="{{true}}"/><view class="muted">{{profile.bio||'让每一次交流，都像山风一样友善。'}}</view><speech-button text="{{profile.bio}}" label="听英文" compact="{{true}}"/></view><button class="small-btn" bindtap="more">···</button></view>
<view wx:if="{{!configured}}" class="notice">营地社交尚未开放。</view>
<scroll-view scroll-y class="messages" scroll-into-view="{{scrollTo}}"><button wx:if="{{hasOlder}}" class="small-btn" data-older="true" bindtap="load" disabled="{{loading}}">查看更早消息</button><view wx:if="{{!messages.length && !loading && !error}}" class="empty">还没有消息。<view>从一句山间问候开始吧。</view></view>
<view wx:for="{{messages}}" wx:key="id" id="message-{{item.seq}}" class="message {{item.mine?'mine':''}}"><view class="message-time">{{item.timeLabel}}</view><view class="bubble"><text selectable>{{item.text}}</text><speech-button text="{{item.text}}" label="朗读英文" compact="{{true}}"/></view></view>
<view wx:if="{{error}}" class="error">{{error}}<text class="link" bindtap="load"> 重试</text></view></scroll-view>
<view class="composer"><view wx:if="{{sendError}}" class="error">{{sendError}}</view><view class="row"><textarea class="message-input" auto-height maxlength="500" value="{{draft}}" bindinput="edit" disabled="{{sending||!configured}}" placeholder="写一句问候…"/><button class="primary" loading="{{sending}}" disabled="{{sending||!configured||!draft}}" bindtap="send">发送</button></view><view class="muted">{{draft.length}} / 500 · 请友善交流</view></view></view>
