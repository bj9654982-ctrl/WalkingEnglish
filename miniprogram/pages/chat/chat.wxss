@import '../../styles/hub.wxss';
.chat-page{height:100vh;display:flex;flex-direction:column;box-sizing:border-box}.chat-header{padding:24rpx 30rpx;border-bottom:1rpx solid #e0e2d3;flex-shrink:0}.messages{flex:1;min-height:0;height:0;box-sizing:border-box;padding:24rpx 30rpx}.message{margin:12rpx 0 28rpx;text-align:left}.message.mine{text-align:right}.message-time{font-size:19rpx;color:#a0a58f;margin:0 8rpx 9rpx}.bubble{display:inline-block;max-width:82%;text-align:left;background:#fffdf5;border:1rpx solid #e4e4d6;padding:20rpx 24rpx;border-radius:18rpx;font-size:28rpx;line-height:1.65;word-break:break-word;white-space:pre-wrap}.mine .bubble{background:#dee7cc;border-color:#d4dfbf}.composer{padding:18rpx 28rpx;padding-bottom:calc(18rpx + env(safe-area-inset-bottom));background:#faf8ee;border-top:1rpx solid #e3e3d4;flex-shrink:0}.message-input{flex:1;width:0;min-height:50rpx;max-height:180rpx;background:#eaeedf;padding:20rpx;border-radius:14rpx;font-size:27rpx}.composer .muted{font-size:19rpx;margin-top:8rpx}
