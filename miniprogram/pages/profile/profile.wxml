<view class="hub"><view class="english-heading"><text class="eyebrow">YOUR OWN LITTLE JOURNEY</text><speech-button text="YOUR OWN LITTLE JOURNEY" compact="{{true}}" label="听读"/></view><view class="title">每一步，都算数。</view>
<view class="row section"><view class="avatar">{{avatars[avatarIndex]}}</view><view class="grow"><view class="name">{{profile?profile.nickname:'山间旅人'}}</view><speech-button text="{{profile.nickname}}" label="听英文" compact="{{true}}"/><view class="muted">{{profile?profile.bio:'给自己一点时间，走自己的山路。'}}</view><speech-button text="{{profile.bio}}" label="听英文" compact="{{true}}"/></view></view>
<view class="card section"><view class="muted">{{book.name}} · 本机旅程</view><view class="stat-grid"><view class="stat"><text class="stat-num">{{learned}}</text><text class="muted">不重复已学词</text></view><view class="stat"><text class="stat-num">{{summits}}</text><text class="muted">登顶次数</text></view><view class="stat"><text class="stat-num">{{minutes}}</text><text class="muted">学习分钟</text></view></view><view class="muted">读完 {{readingCount}} 篇故事 · 发现 {{animalCount}} 种山林朋友</view></view>
<view class="card"><view class="row menu" data-mode="following" bindtap="openSocial"><text>我关注的旅人</text><text class="link">→</text></view><view class="divider"/><view class="row menu" data-mode="inbox" bindtap="openSocial"><text>营地私信</text><text class="link">→</text></view><view class="divider"/><view class="row menu" data-mode="blocked" bindtap="openSocial"><text>屏蔽管理</text><text class="link">→</text></view></view>
<view class="section"><view class="row"><text class="section-title">山林观察手册</text><text class="muted">{{animalCount}} / {{animals.length}}</text></view><view class="animal-grid"><view class="animal-cell {{item.seen?'':'unseen'}}" wx:for="{{animals}}" wx:key="id"><view class="animal-icon">{{item.seen?item.icon:'?'}}</view><view>{{item.seen?item.name:'等待遇见'}}</view><text class="muted">{{item.seen?item.word:'沿途探索'}}</text><speech-button text="{{item.seen?item.word:''}}" label="听发音" compact="{{true}}"/></view></view></view>
<view class="section"><view class="section-title">营地公开资料</view><view wx:if="{{!configured}}" class="notice">营地社交尚未开放。你可以继续学习和收集生物，云端连接完成后再设置资料。</view><view wx:else class="card"><view class="muted">加入营地后，同营地玩家可看到头像、昵称和简介。这里不展示微信号或真实位置。</view><view class="chips"><button wx:for="{{avatars}}" wx:key="*this" class="chip {{avatarIndex===index?'active':''}}" data-index="{{index}}" bindtap="chooseAvatar">{{item}}</button></view><input class="field" value="{{nickname}}" maxlength="20" placeholder="公开昵称，最多 20 字" bindinput="editName"/><textarea class="field bio" value="{{bio}}" maxlength="120" placeholder="写一句山间问候，最多 120 字" bindinput="editBio"/><button class="primary full" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存公开资料</button></view><view wx:if="{{error}}" class="error">{{error}}</view></view>
<button class="reset-link" bindtap="resetProgress">清空本机学习记录</button>
</view>
