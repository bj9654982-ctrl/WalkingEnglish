<view class="hub"><view class="english-heading"><view class="eyebrow"><lookup-text text="PEOPLE ON YOUR PATH" source="页面寄语"/></view><speech-button text="PEOPLE ON YOUR PATH" compact="{{true}}" label="听读"/></view><view class="title">{{mode==='inbox'?'山间来信':mode==='following'?'关注的旅人':'屏蔽管理'}}</view><view class="subtitle">{{mode==='inbox'?'一句问候，让下一程多一点陪伴。':mode==='following'?'在营地相遇，把同行的缘分留住。':'屏蔽后，彼此无法查看或发送私信。'}}</view>
<view wx:if="{{!configured}}" class="notice">营地社交尚未开放，云端连接完成后即可使用。</view><block wx:else><button class="small-btn spaced" bindtap="load" disabled="{{loading}}">刷新列表</button><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="muted spaced">正在加载…</view>
<view wx:for="{{items}}" wx:key="key" class="card spaced">
<block wx:if="{{mode==='inbox'}}"><view class="row" data-id="{{item.conversationId}}" bindtap="chat"><view class="avatar">{{item.profile.avatar}}</view><view class="grow"><view class="row"><text class="name">{{item.profile.nickname}}</text><speech-button text="{{item.profile.nickname}}" label="听英文" compact="{{true}}"/><text wx:if="{{item.unread}}" class="tag">新消息</text></view><view class="muted"><lookup-text text="{{item.lastMessage}}" source="营地私信"/></view><speech-button text="{{item.lastMessage}}" label="朗读英文" compact="{{true}}"/><view class="muted">{{item.timeLabel}}</view></view><text class="link">→</text></view></block>
<block wx:else><view class="row"><view class="avatar">{{item.avatar}}</view><view class="grow"><view class="name">{{item.nickname}}</view><speech-button text="{{item.nickname}}" label="听英文" compact="{{true}}"/><view class="muted"><lookup-text text="{{item.bio}}" source="玩家简介"/></view><speech-button text="{{item.bio}}" label="听英文" compact="{{true}}"/></view></view><view class="row spaced"><button class="secondary grow" data-uid="{{item.uid}}" bindtap="remove" disabled="{{!!busy}}">{{mode==='blocked'?'解除屏蔽':'取消关注'}}</button><button wx:if="{{mode==='following'}}" class="primary grow" data-uid="{{item.uid}}" bindtap="chat" disabled="{{!!busy}}">私信</button></view></block></view>
<view wx:if="{{!items.length && !loading && !error && !cursor}}" class="empty">{{mode==='blocked'?'没有屏蔽的玩家。':'这里还很安静。先去山间营地认识同行的人吧。'}}</view><button wx:if="{{cursor}}" class="secondary full spaced" data-more="true" bindtap="load" disabled="{{loading}}">加载更多</button></block></view>
