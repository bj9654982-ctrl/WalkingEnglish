@import '../../styles/hub.wxss';
.paper-reader { padding-bottom:64rpx; }
.method-title { font-size:27rpx; font-weight:700; letter-spacing:2rpx; }
.bookmark-btn { width:auto; margin:0; padding:8rpx 15rpx; border-radius:20rpx; font-size:23rpx; line-height:1.6; background:#e9eadc; color:#7b846e; }
.bookmark-btn.saved { background:#dde6d4; color:#365b48; }
.reader-title { font-family:Georgia,serif; font-size:41rpx; line-height:1.45; margin:25rpx 0 12rpx; overflow-wrap:break-word; }
.reader-name { font-size:28rpx; line-height:1.7; margin-top:16rpx; }
.version-note { background:#efe8d6; color:#89734c; padding:20rpx 24rpx; border-radius:16rpx; font-size:23rpx; line-height:1.75; margin-top:22rpx; }
.version-note>text { font-weight:600; }
.reader-toolbar { display:flex; flex-wrap:wrap; align-items:center; gap:14rpx; margin:28rpx 0 10rpx; }
.reader-tool { width:auto; background:#e7eadc; color:#65775c; font-size:23rpx; padding:12rpx 19rpx; line-height:1.5; margin:0; border-radius:14rpx; }
.reader-tool.selected { background:#365b48; color:#fff9e9; }
.font-controls { display:flex; align-items:center; gap:6rpx; margin-left:auto; font-size:22rpx; color:#828979; }
.font-btn { width:auto; font-size:29rpx; line-height:1.3; padding:6rpx 16rpx; margin:0; background:transparent; color:#365b48; }
.page-header { display:flex; align-items:center; justify-content:space-between; margin:40rpx 0 20rpx; padding-bottom:15rpx; border-bottom:1rpx solid #dcded0; }
.page-heading { font-size:27rpx; font-weight:600; }
.paper-paragraph { margin:0 0 28rpx; }
.body-text { font-family:Georgia,'Times New Roman',serif; line-height:1.95; color:#3c4e41; overflow-wrap:break-word; }
.paragraph-audio { margin-top:4rpx; }
.source-hint { margin-bottom:20rpx; }
.page-navigation { display:flex; justify-content:space-between; align-items:center; gap:10rpx; border-top:1rpx solid #dddece; padding-top:28rpx; }
.page-arrow { width:auto; font-size:22rpx; padding:15rpx 17rpx; flex-shrink:0; }
.jump-control { display:flex; align-items:center; gap:7rpx; font-size:23rpx; color:#7c8576; }
.page-input { width:58rpx; height:56rpx; border:1rpx solid #cbd2c2; border-radius:10rpx; text-align:center; background:#faf8ef; color:#365b48; }
.jump-button { width:auto; font-size:22rpx; margin:0; padding:8rpx 9rpx; background:transparent; color:#53775b; line-height:1.5; }
.source-card { font-size:21rpx; color:#8c9183; line-height:1.8; margin:35rpx 0 0; overflow-wrap:break-word; }
.source-card>view { margin-top:12rpx; }
.filter-link { background:transparent; color:#53775b; font-size:25rpx; }
