/* 水彩纸、苔绿与旧金色，留出风景和旅人的位置。 */
.trail-page { position: relative; width: 100vw; height: 100vh; overflow: hidden; background: #dce0c8; }
.landscape-canvas { position: absolute; top: 0; left: 0; width: 100vw; height: 100vh; }
.scene-status { position: absolute; top: 38%; left: 40rpx; right: 40rpx; padding: 24rpx; text-align: center; color: #3d5141; background: rgba(243,239,215,.9); border-radius: 12rpx; font-size: 26rpx; }
.scene-retry { margin-top: 20rpx; width: 220rpx; font-size: 26rpx; background: #e5dab5; color: #394c3d; }
.hud-top { position: absolute; left: 0; right: 0; padding: 12rpx 32rpx; display: flex; align-items: center; }
.hud-top .page-back { height: 60rpx; padding: 0 20rpx 0 14rpx; color: #3d5141; border-color: rgba(88,105,74,.25); background: rgba(245,241,220,.8); box-shadow: 0 3rpx 12rpx rgba(41,60,43,.08); z-index: 1; }
.hud-title { margin-left: 18rpx; padding: 5rpx 14rpx; border-radius: 10rpx; min-width: 0; color: #304c3d; background: rgba(245,241,220,.72); text-shadow: 0 1rpx 12rpx #faf5df; }
.hud-name { font-family: "Songti SC", "STSong", serif; font-size: 38rpx; letter-spacing: 5rpx; font-weight: 700; }
.hud-level { font-size: 19rpx; margin-top: 4rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.hud-progress-wrap { position: absolute; left: 36rpx; right: 36rpx; padding: 22rpx 26rpx 18rpx; background: rgba(245,241,221,.79); border: 1rpx solid rgba(255,252,228,.65); border-radius: 4rpx 24rpx 4rpx 24rpx; box-shadow: 0 8rpx 24rpx rgba(51,67,44,.08); color: #435743; }
.chapter-line { display: flex; justify-content: space-between; font-size: 24rpx; }
.chapter-label { letter-spacing: 3rpx; font-family: "Songti SC", "STSong", serif; }
.hud-progress-bar { height: 6rpx; margin-top: 16rpx; background: rgba(75,96,66,.16); border-radius: 9rpx; overflow: hidden; }
.hud-progress-fill { height: 100%; background: linear-gradient(90deg,#6b855f,#aa985d); border-radius: 9rpx; transition: width .4s ease; }
.hud-progress-text { display: flex; justify-content: space-between; font-size: 19rpx; color: #68745b; margin-top: 12rpx; }
.hud-bottom { position: absolute; bottom: 0; left: 0; right: 0; padding: 20rpx 44rpx calc(18rpx + env(safe-area-inset-bottom)); text-align: center; background: linear-gradient(0deg,rgba(24,45,36,.95),rgba(28,48,35,.7) 70%,rgba(28,48,35,0)); }
.trail-camps { display: flex; justify-content: center; margin: 0 20rpx 16rpx; }
.trail-camp { flex: 1; display: flex; flex-direction: column; align-items: center; color: #e0dfbf; font-size: 21rpx; letter-spacing: 2rpx; }
.camp-lantern { font-size: 37rpx; height: 46rpx; color: #9eab85; }
.camp-state { margin-top: 7rpx; font-size: 18rpx; color: #aab49a; letter-spacing: 1rpx; }
.trail-camp-lit .camp-lantern { color: #f1d48e; text-shadow: 0 0 18rpx rgba(250,214,131,.75); }
.trail-camp-lit .camp-state { color: #e8ce8b; }
.trail-camp-due .camp-state, .trail-camp-due .camp-lantern { color: #b4d8cc; }
.hud-review-hint { color: #cbd3b7; font-size: 20rpx; margin-bottom: 16rpx; }
.hud-btn { display: block; width: 100%; margin: 0 auto; background: linear-gradient(125deg,#ebd9a6,#c6b57d); color: #344c39; font-size: 29rpx; font-weight: 600; letter-spacing: 4rpx; border-radius: 10rpx 30rpx 10rpx 30rpx; line-height: 2.9; box-shadow: 0 5rpx 20rpx rgba(15,30,21,.25); }
.hud-btn::after, .hud-review-btn::after, .reset-view::after { border: none; }
.btn-arrow { margin-left: 24rpx; }
.hud-review-btn { width: 100%; background: rgba(207,226,191,.12); border: 1rpx solid rgba(207,226,191,.35); color: #d9e5c6; border-radius: 12rpx; font-size: 24rpx; line-height: 2.5; margin-bottom: 14rpx; }
.hud-tip { font-size: 18rpx; color: #a7b497; margin-top: 18rpx; letter-spacing: 2rpx; }
.reset-view { width: 280rpx; margin: 0 auto 12rpx; padding: 0; color: #e7e5c7; background: rgba(39,60,45,.8); border-radius: 99rpx; font-size: 20rpx; line-height: 2.2; }
.trail-studying .hud-top { opacity: .95; }
.encounter-badge { background:rgba(243,232,190,.94);color:#3d5841;border-radius:16rpx;padding:14rpx 18rpx;margin-bottom:14rpx;line-height:1.5;font-size:24rpx; }
.camp-reached { border-color:rgba(225,223,160,.6);background:rgba(160,173,115,.16); }
.encounter-mask { position:fixed;inset:0;z-index:150;background:rgba(22,41,32,.65);display:flex;align-items:center;justify-content:center;padding:36rpx; }
.encounter-card { box-sizing:border-box;width:100%;max-height:85vh;overflow-y:auto;background:#f8f3e4;border:2rpx solid #d9d9b9;border-radius:28rpx;padding:32rpx;text-align:center;color:#425b44; }
.encounter-label { font-size:22rpx;letter-spacing:5rpx;color:#879371; }.encounter-icon { font-size:90rpx;margin:22rpx 0 8rpx; }.encounter-name { font-size:38rpx;font-weight:600; }.encounter-hint { font-size:25rpx;line-height:1.8;color:#7b856c;margin:15rpx 0; }
.encounter-question { font-size:27rpx;margin:20rpx 0; }.animal-choice { font-family:Georgia,serif;font-size:31rpx;line-height:1.5;padding:14rpx;margin:12rpx 0;background:#e5e9d3;color:#415a43;border-radius:14rpx; }.animal-feedback { font-size:23rpx;color:#8d7750;margin:20rpx 0; }
.animal-collect { background:#415e45;color:#fff5d7;border-radius:16rpx;font-size:28rpx; }.animal-skip { background:transparent;color:#849074;font-size:24rpx;margin-top:16rpx; }.encounter-word { font-family:Georgia,serif;font-size:42rpx;margin:20rpx 0; }.encounter-sentence { font-size:28rpx;line-height:1.7; }.encounter-fact { background:#eeecd7;padding:22rpx;font-size:25rpx;line-height:1.8;border-radius:14rpx; }
.animal-choice,.animal-collect,.animal-skip,.encounter-badge { width:100%; }
.animal-collect,.animal-skip { padding:18rpx 22rpx;line-height:1.5; }

.animal-answer { display: flex; align-items: center; gap: 12rpx; }
.animal-answer .animal-choice { flex: 1; min-width: 0; }
.encounter-card { max-height: 80vh; overflow-y: auto; }
