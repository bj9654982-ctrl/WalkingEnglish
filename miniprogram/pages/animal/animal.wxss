@import '../../styles/hub.wxss';
.animal-hero { text-align:center; padding:30rpx 0; }
.animal-portrait,.unknown-portrait { font-size:120rpx; margin:15rpx 0 25rpx; }
.animal-word { font-family:Georgia,serif; font-size:40rpx; margin:8rpx 0 10rpx; }
.animal-sentence { font-family:Georgia,serif; font-size:32rpx; line-height:1.8; color:#3d5746; }
.detail-copy { font-size:28rpx; line-height:1.9; }
.visit-row { display:flex; justify-content:space-between; border-bottom:1rpx solid #e0e2d4; padding:22rpx 0; font-size:27rpx; }
