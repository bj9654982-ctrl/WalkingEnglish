:host { display: inline-block; vertical-align: middle; max-width: 100%; flex-shrink: 0; }
.listen { display: inline-flex; width: auto; max-width: 100%; min-width: 0; align-items: center; justify-content: center; gap: 8rpx; box-sizing: border-box; min-height: 56rpx; margin: 6rpx 0; padding: 7rpx 16rpx; background: #e4ebdf; color: #365b48; border: 1rpx solid #bdcdb8; border-radius: 30rpx; font-size: 22rpx; line-height: 1.5; font-weight: 500; white-space: nowrap; }
.listen::after { border: 0; }
.listen.active { background: #365b48; color: #fffaf0; border-color: #365b48; }
.listen.compact { min-height: 48rpx; padding: 5rpx 12rpx; font-size: 20rpx; }
.listen.icon-only { width:52rpx; height:52rpx; min-height:52rpx; padding:0; border-radius:50%; gap:0; }
.symbol { font-size: 19rpx; }
.progress { opacity: .8; font-size: 20rpx; }
