<button wx:if="{{readable}}" class="listen {{compact?'compact':''}} {{active?'active':''}}" catchtap="toggle" aria-label="{{active?'停止朗读':label}}" aria-role="button"><text class="symbol">{{active?'■':'▶'}}</text><text>{{active?(loading?'加载中 · 停止':'停止'):failed?'重试':label}}</text><text wx:if="{{progress}}" class="progress">{{progress}}</text></button>
